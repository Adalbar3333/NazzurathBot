# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# The requested homebrew notification channel is the default.
HOMEBREW_CHANNEL_ID=1548461625865015466
# Optional role to ping for a brand-new proposal. Leave 0 for no ping.
HOMEBREW_ROLE_ID=0

# Fine-grained token scoped only to Tazzurath-Website with Contents: Read and Issues: Read.
GITHUB_TOKEN=
GITHUB_OWNER=Adalbar3333
GITHUB_REPO=Tazzurath-Website
GITHUB_BRANCH=main
WEBSITE_URL=https://www.tazzurath.com

# Optional but recommended: use the same value as the website's NEXTAUTH_SECRET.
# This lets the bot cryptographically reject forged proposal/vote metadata.
HOMEBREW_SIGNING_SECRET=

# Existing Nazzurath server features (current IDs are supplied as defaults in code).
ADMIN_ROLE_ID=998390105217716296
TRUSTED_ROLE_ID=998391075905474630
FORWARD_CHANNEL_ID=1360707370732486868
AVRAE_USER_ID=261302296103747584

GITHUB_POLL_SECONDS=60
# Set true only if the bot should post every existing registry item on its first run.
ANNOUNCE_EXISTING_SUBMISSIONS=false
PORT=8080
LOG_LEVEL=INFO
